{
	"name": "n8n-nodes-passbolt",
	"version": "0.1.0",
	"description": "n8n community node for Passbolt password manager",
	"author": {
		"name": "Pierre Colart",
		"email": "pierre@colart.io"
	},
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/switch-case/passbolt-n8n.git"
	},
	"homepage": "https://gitlab.com/switch-case/passbolt-n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"passbolt",
		"password",
		"secret",
		"vault"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "dist/nodes/Passbolt/Passbolt.node.js",
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lintfix": "eslint nodes credentials --fix",
		"prepublishOnly": "npm run build",
		"verify": "npx @n8n/scan-community-package n8n-nodes-passbolt"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PassboltApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Passbolt/Passbolt.node.js"
		]
	},
	"dependencies": {
		"openpgp": "^5.11.0",
		"uuid": "^9.0.1"
	},
	"bundledDependencies": ["openpgp", "uuid"],
	"devDependencies": {
		"@eslint/eslintrc": "^3.0.0",
		"@types/node": "^20.19.33",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.2",
		"gulp": "^4.0.2",
		"n8n-workflow": "^1.36.0",
		"prettier": "^3.2.0",
		"typescript": "~5.4.0"
	},
	"peerDependencies": {
		"n8n-workflow": ">=1.36.0"
	}
}
